# Copier en .env (jamais commité). En CI, utiliser les secrets GitHub.
ANTHROPIC_API_KEY=
# Optionnel : navigateur utilisé par Remotion pour le rendu (sinon Remotion télécharge le sien)
REMOTION_BROWSER=
# Publication via Upload-Post (en CI : secret UPLOAD_POST_API_KEY et variable UPLOAD_POST_USER)
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
